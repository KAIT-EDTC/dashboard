{
  "name": "edtc-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w client",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "deploy": "npm run build && npm run deploy -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~6.0.3"
  }
}
