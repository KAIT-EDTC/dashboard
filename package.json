{
  "name": "edtc-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w client",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:seed:clear": "npm run db:seed:clear -w server",
    "deploy": "npm run build && npm run deploy -w server",
    "db:migrate:remote": "npm run db:migrate:remote -w server",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "concurrently": "^10.0.6",
    "secretlint": "^13.1.0",
    "typescript": "~6.0.3"
  }
}
