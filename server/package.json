{
  "name": "@edtc/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production --minify",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply edtc-dashboard --local",
    "db:seed": "npm run db:seed:clear && wrangler d1 execute edtc-dashboard --local --file seed/seed.sql",
    "db:seed:clear": "wrangler d1 execute edtc-dashboard --local --file seed/clear.sql",
    "db:migrate:remote": "wrangler d1 migrations apply edtc-dashboard --remote --env production"
  },
  "dependencies": {
    "@edtc/shared": "*",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.151.0"
  }
}
