# `cp .dev.vars.example .dev.vars` して値を埋める（.dev.vars はコミットしない）

# --- Discord OAuth2 (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/callback
# EDTCサーバーのID
DISCORD_GUILD_ID=
# 管理者として扱うロールID（カンマ区切り）
DISCORD_ADMIN_ROLE_IDS=
# 通知先チャンネルのWebhook URL（未設定なら通知しない）
DISCORD_WEBHOOK_URL=

# --- Session ---
JWT_SECRET=
# 本番のみ（例: .kaitedtc.com）。未設定ならホスト限定Cookie
COOKIE_DOMAIN=

# --- GitHub App (ブログPR用) ---
GITHUB_APP_ID=
# PEM（改行は \n でエスケープ可）。PKCS#1 / PKCS#8 どちらでも可
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
