# cp .dev.vars.example .dev.vars して必要に応じて値を埋めてください。
# 基本的な開発では DEV_LOGIN さえ埋めてあれば OK です。

# 開発時ダミーユーザーでログイン
DEV_LOGIN=true

# 認証周りの開発で必須
JWT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# GitHub App (ブログPR用)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
